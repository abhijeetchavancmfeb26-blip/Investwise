# Copy to .env next to docker-compose.yml. Every value has a working default,
# so the stack starts without this file; set these when you want real email
# or real Razorpay checkout.

# --- Security -------------------------------------------------------
# HS256 signing key. Must be at least 64 characters. The user service signs
# tokens with it, the investment service only verifies them, so both
# containers must receive the same value.
INVESTWISE_JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVm

# --- Email (Spring Mail, Gmail SMTP by default) ----------------------
# Leave INVESTWISE_MAIL_ENABLED=false and the service logs the email body to
# the console and to the Mongo email_logs collection instead of sending it.
INVESTWISE_MAIL_ENABLED=false
INVESTWISE_MAIL_USERNAME=
INVESTWISE_MAIL_PASSWORD=
INVESTWISE_MAIL_FROM=no-reply@investwise.in

# --- Razorpay --------------------------------------------------------
# Test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
